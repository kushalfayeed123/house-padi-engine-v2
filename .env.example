# ============================================================================
# HousePadi Engine v2 — environment template
# Copy to `.env` and fill in. Only the first two are strictly required to boot.
# ============================================================================

# --- Required: datastore -------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Environment ---------------------------------------------------------
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated allow-list. Required (and must not be '*') in production.
CORS_ORIGINS=http://localhost:3000

# --- Auth / LLM (chat needs GROQ_API_KEY; search needs OPENROUTER_API_KEY) -
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
BACKEND_JWT_SECRET=

# --- Payments ------------------------------------------------------------
# mock | paystack | flutterwave | stripe
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
# Falls back to PAYMENT_SECRET_KEY when unset (Paystack signs with the secret key).
PAYMENT_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=5
DEFAULT_CURRENCY=NGN
# Frontend route the gateway redirects back to after checkout.
PAYMENT_CALLBACK_URL=http://localhost:3000/payments/callback
PUBLIC_BASE_URL=http://localhost:8000
REQUIRE_KYC_FOR_PAYMENT=true

# --- Internal jobs -------------------------------------------------------
# No default: the internal cron endpoint returns 401 when this is unset.
INTERNAL_CRON_SECRET=

# --- Cache (optional; falls back to in-process memory) -------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_MAX_ENTRIES=1000
